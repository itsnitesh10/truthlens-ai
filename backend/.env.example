# TruthLens AI — Backend Environment Variables
# Copy this file to .env and fill in your values

# ── Ollama Local LLM (Free — no API key needed) ───────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b
OLLAMA_TIMEOUT_SECONDS=120

# ── App Settings ──────────────────────────────────────────────────
APP_ENV=development
APP_PORT=8000
ALLOWED_ORIGINS=http://localhost:3000

# ── Database ──────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/truthlens
MONGO_URI=mongodb://localhost:27017/truthlens
REDIS_URL=redis://localhost:6379

# ── Vector DB ─────────────────────────────────────────────────────
FAISS_INDEX_PATH=./vector-db/faiss_index

# ── Optional APIs ─────────────────────────────────────────────────
GOOGLE_FACT_CHECK_API_KEY=your-key-here
NEWS_API_KEY=your-key-here

# ── File Upload ───────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=50
UPLOAD_DIR=./uploads
